# VM 의 /opt/byeolmyeong/.env 틀(결정 020). 이름만 적는다. 값은 VM 에서 채우고 저장소에 올리지 않는다. 권한은 600.
# compose 가 이 파일을 두 번 쓴다: ${...} 치환(SITE_ADDRESS·DATABASE_*)과 서버 컨테이너의 환경 변수(env_file).
# 서버 설정 이름의 원본은 저장소 루트의 .env.example 이다. 거기에 이름이 늘면 여기도 더한다.
# 주의:
# - `이름=` 처럼 값이 빈 줄도 "빈 값이 있다"로 읽혀 서버의 기본값을 덮는다. 안 쓰는 이름은 줄째 지우거나 # 로 막는다.
# - 값에 따옴표·`$` 를 쓰지 않는다. compose 는 따옴표를 벗기고 `$` 를 치환하지만 스크립트는 그대로 읽어 둘이 달라진다.
#   공백·`\n`(역슬래시+n 두 글자)은 그대로 넘어간다(애플 개인 키처럼). 비밀번호는 `openssl rand -hex 24` 로 영문·숫자만.
# - 이 파일은 서버 컨테이너에 그대로 넘어간다. 그래서 DB 최고 관리자 비밀번호는 db.env(deploy/db.env.example),
#   운영의 백업 업로드 URL 은 backup.env(deploy/backup.env.example)에 따로 둔다.

# Caddy 가 인증서를 받을 주소. 운영 api.byeolmyeong.com · 스테이징 api-staging.byeolmyeong.com
SITE_ADDRESS=
# 서버 JVM 의 최대 힙(결정 050). 운영(A1 12GB) 1g · 스테이징(E2.1.Micro 1GB)은 이 줄을 지우거나 # 로 막는다(256m 이 된다).
# compose 의 ${...} 치환에만 쓴다. 빈 값(`API_HEAP_MAX=`)도 256m 이 된다.
#API_HEAP_MAX=1g
# 배포 환경(결정 022). 운영 prod · 스테이징 staging. 비우면 prod 로 보고, 개발용 로그인이 켜져 있으면 서버가 시작하지 않는다.
DEPLOY_ENV=

# 서버가 쓰는 일반 계정(DB byeolmyeong 의 소유자). 처음 초기화 때 이 값으로 만들어진다. 이름은 postgres 가 아니어야 한다(예: byeolmyeong_app).
# 나중에 비밀번호를 바꾸려면 DB 에서 먼저 `alter role … password …` 를 하고 이 값을 바꾼 뒤 서버를 다시 만든다.
DATABASE_USERNAME=
DATABASE_PASSWORD=
# compose 내부망의 DB: jdbc:postgresql://postgres:5432/byeolmyeong
DATABASE_URL=

# 운영·스테이징이 같은 키를 쓴다(결정 020 #6). Anthropic 콘솔에서 그 키에 지출 한도를 꼭 건다.
ANTHROPIC_API_KEY=
# 푸시를 보내는 Expo 접근 토큰(결정 042). 없으면 서버는 뜨고 푸시만 보내지 않는다(로그만).
EXPO_ACCESS_TOKEN=
# 웹 앱 주소(앱 결정 037). 운영 https://app.byeolmyeong.com · 스테이징 https://app.staging.byeolmyeong.com
ALLOWED_ORIGINS=
# 운영 https://admin.byeolmyeong.com · 스테이징 https://admin-staging.byeolmyeong.com
ADMIN_ALLOWED_ORIGINS=

# ── 소셜 로그인(결정 021). 공급자 콘솔에서 받은 값. 비어 있으면 서버는 뜨고 그 공급자 로그인만 안 된다. 설명의 원본은 루트 .env.example ──
# 공급자 콘솔에는 운영·스테이징 웹 주소를 둘 다 등록한다(애플 Services ID 의 반환 주소, 카카오 리다이렉트 URI).
GOOGLE_CLIENT_IDS=
# 위 목록 가운데 웹 클라이언트 ID(비밀 아님). 웹 리디렉트의 ID 토큰을 만료까지 한 번만 받는다(결정 047). 비면 검사를 끈다.
GOOGLE_WEB_CLIENT_ID=
# 앱 클라이언트 ID(쉼표로 여럿, 비밀 아님) — 앱의 EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID · 구글 클라우드의 안드로이드 클라이언트(서명마다). 로그 이름표에만 쓴다(결정 047).
GOOGLE_IOS_CLIENT_IDS=
GOOGLE_ANDROID_CLIENT_IDS=
APPLE_CLIENT_IDS=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# .p8 파일 내용을 한 줄로, 줄바꿈 자리에 \n 두 글자(예: -----BEGIN PRIVATE KEY-----\nMIGT...\n-----END PRIVATE KEY-----)
APPLE_PRIVATE_KEY=
KAKAO_REST_API_KEY=
KAKAO_NATIVE_APP_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_ADMIN_KEY=
# 운영 https://app.byeolmyeong.com/auth/kakao · 스테이징 https://app.staging.byeolmyeong.com/auth/kakao
KAKAO_REDIRECT_URIS=
# SESSION_COOKIE_SECURE 는 적지 않는다(배포는 https 라 기본값 true). 빈 값으로 두면 서버가 뜨지 않는다.

# 모델은 운영·스테이징 모두 기본값(application.properties 의 claude-opus-5-5)을 쓴다. 바꿀 때만 주석을 푼다.
# CLAUDE_MODEL=
# 스테이징만 주석을 푼다. 운영에서는 절대 켜지 않는다(누구나 같은 개발용 계정으로 들어온다).
# 스테이징에도 실제 출생 정보는 넣지 않는다. 주소를 아는 누구나 같은 계정으로 본다.
# AUTH_DEV_ENABLED=true
# 첫 관리자를 만들 때만 주석을 풀고 값을 넣는다. 만든 뒤 다시 지운다.
# ADMIN_BOOTSTRAP_ID=
# ADMIN_BOOTSTRAP_PASSWORD=
# 자세한 풀이 결제 시작 시각(결정 056). 1.1.0 출시일에 소유자 승인 뒤에만 넣고 다시 배포한다. 비우면 결제 없이 모두 받는다.
# PURCHASE_STARTS_AT=2026-12-10T00:00:00+09:00
