# VM 의 /opt/byeolmyeong/.env 틀(결정 020). 이름만 적는다. 값은 VM 에서 소유자가 채우고 저장소에 올리지 않는다.
# compose 가 이 파일을 두 번 쓴다: ${...} 치환(SITE_ADDRESS·DATABASE_*)과 서버 컨테이너의 환경 변수(env_file).
# 서버 설정 이름의 원본은 저장소 루트의 .env.example 이다. 거기에 이름이 늘면 여기도 더한다.
# 주의: `이름=` 처럼 값이 빈 줄도 "빈 값이 있다"로 읽혀 서버의 기본값을 덮는다. 안 쓰는 이름은 줄째 지우거나 # 로 막는다.

# ── 배포에만 쓰는 것 ──
# Caddy 가 인증서를 받을 주소. 운영 api.byeolmyeong.com · 스테이징 api-staging.byeolmyeong.com
SITE_ADDRESS=
# 운영만: 백업을 올릴 Object Storage 사전 인증 URL(쓰기 전용, 버킷 주소이고 끝이 /). 스테이징은 이 줄을 지운다.
BACKUP_UPLOAD_URL=

# ── 서버 설정 ──
# 환경마다 따로 발급한 키. 스테이징 키에는 Anthropic 콘솔에서 지출 한도를 건다.
ANTHROPIC_API_KEY=
# compose 내부망의 DB: jdbc:postgresql://postgres:5432/byeolmyeong
DATABASE_URL=
# 서버와 DB 컨테이너가 같이 쓴다. 환경마다 다른 값.
DATABASE_USERNAME=
DATABASE_PASSWORD=
# 운영 https://byeolmyeong.com · 스테이징 https://staging.byeolmyeong.com
ALLOWED_ORIGINS=
# 운영 https://admin.byeolmyeong.com · 스테이징 https://admin-staging.byeolmyeong.com
ADMIN_ALLOWED_ORIGINS=

# 스테이징만 주석을 푼다. 운영은 기본값(application.properties 의 claude-opus-5-5)을 쓴다.
# CLAUDE_MODEL=claude-sonnet-5-5
# 스테이징만 주석을 푼다. 운영에서는 절대 켜지 않는다(누구나 같은 개발용 계정으로 들어온다).
# AUTH_DEV_ENABLED=true
# 첫 관리자를 만들 때만 주석을 풀고 값을 넣는다. 만든 뒤 다시 지운다.
# ADMIN_BOOTSTRAP_ID=
# ADMIN_BOOTSTRAP_PASSWORD=
