# 주소는 .env 의 SITE_ADDRESS(운영 api.byeolmyeong.com · 스테이징 api-staging.byeolmyeong.com).
# 인증서는 Caddy 가 Let's Encrypt 에서 받고 갱신한다. 80 은 인증서 확인과 https 로 넘기기에만 쓴다.
# 밖에서 온 X-Forwarded-For 는 믿지 않고 실제 연결 주소로 바꿔 넘긴다(Caddy 기본 동작).
# 앞에 Cloudflare 프록시 같은 것을 두게 되면 trusted_proxies 를 먼저 정한다. 안 하면 주소별 제한이 프록시 주소로 뭉친다.
{$SITE_ADDRESS} {
	# 브라우저가 이 주소를 앞으로 1년 동안 https 로만 연다.
	header Strict-Transport-Security "max-age=31536000"
	reverse_proxy api:8080
}
