# 변수 이름만 적는다. 값은 .env 에 두고 .env 는 커밋하지 않는다.
# 글 생성(Claude API). 없으면 서버는 뜨고 생성 요청만 502 가 된다.
ANTHROPIC_API_KEY=
# 푸시를 보내는 Expo 접근 토큰(결정 042). 없으면 서버는 뜨고 푸시만 보내지 않는다(로그만).
EXPO_ACCESS_TOKEN=
# 글 생성 모델을 바꿀 때만 적는다(기본값은 application.properties).
CLAUDE_MODEL=
# JDBC 주소. 로컬 compose.yaml 의 DB 는 jdbc:postgresql://localhost:5432/byeolmyeong
DATABASE_URL=
# compose.yaml 의 DB 와 서버가 같이 쓴다.
DATABASE_USERNAME=
DATABASE_PASSWORD=
# 웹 앱이 열리는 주소. 쉼표로 구분. 로컬 개발은 http://localhost:8081
ALLOWED_ORIGINS=
# 관리 화면(웹)이 열리는 주소. 쉼표로 구분. /admin/** 만 이 주소에 열린다. 로컬 개발 예: http://localhost:5173
ADMIN_ALLOWED_ORIGINS=
# 개발용 로그인을 연다(true). 로컬 개발과 스테이징에서만 쓴다(결정 020). 운영에서는 적지 않는다.
AUTH_DEV_ENABLED=
# 배포 환경(결정 022): 로컬 개발은 local. 비우면 prod 로 보고, 개발용 로그인을 켠 서버는 시작하지 않는다.
DEPLOY_ENV=
# 첫 관리자(관리자 API). 관리자가 한 명도 없을 때 서버가 뜨면서 이 값으로 하나 만든다. 둘 다 있어야 한다.
# 아이디는 소문자·숫자·.·_·- 3~32자, 비밀번호는 10자 이상(72바이트 이하). 만든 뒤에는 지워도 된다(관리자가 있으면 읽지 않는다).
ADMIN_BOOTSTRAP_ID=
ADMIN_BOOTSTRAP_PASSWORD=
# 소셜 로그인(결정 021). 공급자 콘솔에서 받은 값. 쉼표로 여러 개를 적을 수 있는 것은 이름이 복수(…S)다.
# 구글 ID 토큰의 대상(aud). 구글 클라우드의 "웹" OAuth 클라이언트 ID(앱도 이 값으로 ID 토큰을 받는다).
GOOGLE_CLIENT_IDS=
# 위 목록 가운데 웹 클라이언트 ID(비밀 아님). 웹 리디렉트의 ID 토큰을 만료까지 한 번만 받는다(결정 047). 비면 검사를 끈다.
GOOGLE_WEB_CLIENT_ID=
# 앱 클라이언트 ID(쉼표로 여럿, 비밀 아님) — 앱의 EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID · 구글 클라우드의 안드로이드 클라이언트(서명마다). 로그 이름표에만 쓴다(결정 047).
GOOGLE_IOS_CLIENT_IDS=
GOOGLE_ANDROID_CLIENT_IDS=
# 애플 ID 토큰의 대상(aud). 번들 ID(iOS 앱)와 Services ID(웹).
APPLE_CLIENT_IDS=
# 애플 토큰 교환·철회용 client_secret 을 만드는 값. 개인 키는 .p8 파일의 내용을 한 줄로, 줄바꿈 자리에 \n 두 글자를 넣는다
# (예: -----BEGIN PRIVATE KEY-----\nMIGT...\n-----END PRIVATE KEY-----). .env 는 여러 줄 값을 읽지 못해 첫 줄만 들어간다.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# 카카오. REST API 키·네이티브 앱 키는 ID 토큰의 대상(aud), 클라이언트 시크릿은 웹 인가 코드 교환, 어드민 키는 탈퇴 때 연결 끊기.
KAKAO_REST_API_KEY=
KAKAO_NATIVE_APP_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_ADMIN_KEY=
# 카카오 웹 로그인이 돌아올 주소(카카오 콘솔에 등록한 것과 같게). 로컬 개발 예: http://localhost:8081/auth/kakao
KAKAO_REDIRECT_URIS=
# 웹 세션 쿠키의 Secure. 로컬 http 개발에서만 false 로 적는다. 쓰지 않으면 줄을 지운다 — 빈 값(SESSION_COOKIE_SECURE=)이면 서버가 뜨지 않는다.
SESSION_COOKIE_SECURE=
# 자세한 풀이 결제 시작 시각(결정 056). 오프셋이 붙은 ISO-8601(예 2026-12-10T00:00:00+09:00). 비우면 결제 없이 모두 받는다(1.0.0 과 같다).
PURCHASE_STARTS_AT=
# 자세한 풀이를 산 계정 확인(RevenueCat REST 비밀 키, 결정 056). 비우면 결제 시작 뒤 RevenueCat 을 묻지 못해 표에 없는 계정의 받기가 503 이다.
REVENUECAT_SECRET_KEY=
