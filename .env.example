# 변수 이름만 적는다. 값은 .env 에 두고 .env 는 커밋하지 않는다.
# 글 생성(Claude API). 없으면 서버는 뜨고 생성 요청만 502 가 된다.
ANTHROPIC_API_KEY=
# 글 생성 모델을 바꿀 때만 적는다(기본값은 application.properties).
CLAUDE_MODEL=
# JDBC 주소. 로컬 compose.yaml 의 DB 는 jdbc:postgresql://localhost:5432/byeolmyeong
DATABASE_URL=
# compose.yaml 의 DB 와 서버가 같이 쓴다.
DATABASE_USERNAME=
DATABASE_PASSWORD=
# 웹 앱이 열리는 주소. 쉼표로 구분. 로컬 개발은 http://localhost:8081
ALLOWED_ORIGINS=
# 개발용 로그인을 연다(true). 로컬 개발에서만 쓴다. 운영에서는 적지 않는다.
AUTH_DEV_ENABLED=
