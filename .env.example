# 변수 이름만 적는다. 값은 .env 에 두고 .env 는 커밋하지 않는다.
# 글 생성(Claude API). 없으면 서버는 뜨고 생성 요청만 502 가 된다.
ANTHROPIC_API_KEY=
# 글 생성 모델을 바꿀 때만 적는다(기본값은 application.properties).
CLAUDE_MODEL=
# JDBC 주소. 로컬 compose.yaml 의 DB 는 jdbc:postgresql://localhost:5432/byeolmyeong
DATABASE_URL=
# compose.yaml 의 DB 와 서버가 같이 쓴다.
DATABASE_USERNAME=
DATABASE_PASSWORD=
# 웹 앱이 열리는 주소. 쉼표로 구분. 로컬 개발은 http://localhost:8081
ALLOWED_ORIGINS=
# 관리 화면(웹)이 열리는 주소. 쉼표로 구분. /admin/** 만 이 주소에 열린다. 로컬 개발 예: http://localhost:5173
ADMIN_ALLOWED_ORIGINS=
# 개발용 로그인을 연다(true). 로컬 개발과 스테이징에서만 쓴다(결정 020). 운영에서는 적지 않는다.
AUTH_DEV_ENABLED=
# 첫 관리자(관리자 API). 관리자가 한 명도 없을 때 서버가 뜨면서 이 값으로 하나 만든다. 둘 다 있어야 한다.
# 아이디는 소문자·숫자·.·_·- 3~32자, 비밀번호는 10자 이상(72바이트 이하). 만든 뒤에는 지워도 된다(관리자가 있으면 읽지 않는다).
ADMIN_BOOTSTRAP_ID=
ADMIN_BOOTSTRAP_PASSWORD=
